# Copy to .env.local for local dev, and set the same names in Vercel (Project > Settings > Environment Variables).

# REQUIRED for the whistleblower report form (/report). Without it every submission shows the error state.
# Create a Formspree form for reports and paste its endpoint, e.g. https://formspree.io/f/xxxxxxxx
NEXT_PUBLIC_REPORT_FORMSPREE_URL=

# Optional: the site falls back to the current project values if these are unset.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
